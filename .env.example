# Project: atlas
# Generated by codex-django

# Security
SECRET_KEY=replace-with-your-django-secret-key  # pragma: allowlist secret
DEBUG=True
# Required for encrypted model fields. Generate a Fernet key, for example:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-your-fernet-field-encryption-key  # pragma: allowlist secret

# Application
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_BASE_URL=http://127.0.0.1:8000/

# Database
# DATABASE_URL=postgres://user:pass@localhost:5432/atlas  # pragma: allowlist secret

# Redis / ARQ
# For local Redis:
# REDIS_URL=redis://localhost:6379/0
# Optional: use a separate ARQ Redis URL when queues should not share the default cache Redis.
# ARQ_REDIS_URL=redis://localhost:6379/1
# For Upstash Redis over TLS:
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_PASSWORD=replace-with-upstash-redis-password  # pragma: allowlist secret

# Workers / AI
# Gemini is the default provider for the translator/formatter worker.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=replace-with-google-ai-studio-api-key  # pragma: allowlist secret
# GOOGLE_API_KEY=replace-with-google-ai-studio-api-key  # pragma: allowlist secret
# OPENAI_API_KEY=replace-with-openai-api-key  # pragma: allowlist secret
# OPENAI_MODEL=gpt-4o-mini
AI_MAX_RETRIES=2
AI_RETRY_DELAY_SECONDS=2.0
# When True, smart preview still returns formatted placeholder text if no AI key is configured.
AI_STUB_WHEN_UNCONFIGURED=True

# Notification worker / SMTP
EMAIL_FROM_NAME=Atlas
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=replace-with-smtp-user
# EMAIL_HOST_PASSWORD=replace-with-smtp-password  # pragma: allowlist secret
# DEFAULT_FROM_EMAIL=no-reply@example.com
# EMAIL_USE_TLS=True
